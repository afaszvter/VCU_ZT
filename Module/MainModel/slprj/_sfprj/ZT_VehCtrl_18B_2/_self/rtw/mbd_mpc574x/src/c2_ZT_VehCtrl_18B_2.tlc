%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   3 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "is_active_c2_ZT_VehCtrl_18B_2"\
      Description  "StateIsActive"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_FrontDrive"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         "DriveControl.FrontDrive"\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "is_RearDrive"\
      Description  "StateActiveChild"\
      SFName       ""\
      Path         "DriveControl.RearDrive"\
      SrcLocation  ""\
    }\
  }
  %return ChartDataElements
%endfunction
